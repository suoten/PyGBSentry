{
  "name": "PyGBSentry-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:no-js-mirrors && npm run check:no-raw-axios-detail && vite build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:ci": "vue-tsc -p tsconfig.ci.json --noEmit",
    "build:full": "npm run check:no-js-mirrors && npm run check:no-raw-axios-detail && vue-tsc && vite build",
    "check:no-js-mirrors": "node ./scripts/check-no-js-mirrors.mjs",
    "check:no-raw-axios-detail": "node ../../../tools/frontend/check-no-raw-axios-detail.mjs",
    "verify:runtime-coverage": "python ../tools/check_runtime_coverage.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.9.0",
    "dompurify": "^3.3.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.9.1",
    "flv.js": "^1.6.2",
    "ol": "^10.8.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "^1.4.0",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.24.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.71.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.4.5",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.4.1",
    "vitest": "^1.4.0",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "typescript": "5.4.5"
  }
}
