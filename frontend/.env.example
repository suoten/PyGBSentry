# PyGBSentry Frontend Environment Variables
# Copy to .env.development or .env.production and adjust as needed

# API base URL (empty = same origin, useful for reverse proxy)
VITE_API_BASE_URL=

# API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# Token cache TTL in milliseconds (default: 5000)
# Controls how long role/permission info is cached client-side
VITE_TOKEN_CACHE_TTL=5000

# App edition: 'oss' (open source) or 'server' (commercial)
VITE_APP_EDITION=oss

# Allow public user registration: 'true' or 'false' (default: false)
# Must match backend ALLOW_PUBLIC_REGISTRATION setting
VITE_ALLOW_PUBLIC_REGISTRATION=false

# Dev proxy target (development only — vite dev server proxies /api to this URL)
VITE_DEV_API_TARGET=http://localhost:8000
