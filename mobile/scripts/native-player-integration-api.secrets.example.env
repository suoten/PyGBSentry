# GitHub Actions secrets template for native integration report API-only gate.
# Add these keys into repository secrets (Settings -> Secrets and variables -> Actions).

# Required: report API endpoint that returns JSON report or { "report": { ... } }.
NATIVE_PLAYER_INTEGRATION_REPORT_API_URL=https://devicefarm.example.com/api/v1/native-player/integration-report/latest

# Optional but recommended: bearer token for API authentication.
NATIVE_PLAYER_INTEGRATION_REPORT_API_TOKEN=replace-with-token

# Optional: enterprise alert webhook for required-gate failures.
# NATIVE_PLAYER_INTEGRATION_ALERT_WEBHOOK_URL=https://hooks.example.com/native-gate-alert
# NATIVE_PLAYER_INTEGRATION_ALERT_WEBHOOK_TOKEN=replace-with-alert-token
# Optional: route by level (fallback to ALERT_WEBHOOK_URL if unset).
# NATIVE_PLAYER_INTEGRATION_ALERT_WEBHOOK_URL_ERROR=https://hooks.example.com/native-gate-error
# NATIVE_PLAYER_INTEGRATION_ALERT_WEBHOOK_URL_WARNING=https://hooks.example.com/native-gate-warning
# NATIVE_PLAYER_INTEGRATION_ALERT_WEBHOOK_URL_INFO=https://hooks.example.com/native-gate-info
# Optional: escalation channel for severe failures.
# NATIVE_PLAYER_INTEGRATION_ALERT_ESCALATION_WEBHOOK_URL=https://hooks.example.com/native-gate-escalation
# Optional: mute specific reason codes to reduce noise (comma-separated).
# NATIVE_PLAYER_INTEGRATION_ALERT_MUTE_REASON_CODES=API_URL_MISSING,STATUS_FILE_MISSING
# Optional: override alert levels by reason code (error|warning|info).
# NATIVE_PLAYER_INTEGRATION_ALERT_LEVEL_OVERRIDES=HTTP_ERROR=warning,REQUEST_TIMEOUT=error
# Optional: escalation triggers by reason code (comma-separated).
# NATIVE_PLAYER_INTEGRATION_ALERT_ESCALATE_REASON_CODES=INVALID_JSON,REQUEST_TIMEOUT
# Optional: webhook send retry policy.
# NATIVE_PLAYER_INTEGRATION_ALERT_RETRIES=1
# NATIVE_PLAYER_INTEGRATION_ALERT_RETRY_DELAY_MS=1000
# Optional: dedupe window and alert summary paths.
# NATIVE_PLAYER_INTEGRATION_ALERT_DEDUPE_WINDOW_SEC=600
# NATIVE_PLAYER_INTEGRATION_ALERT_DEDUPE_STATE_PATH=scripts/native-player-integration.alert-dedupe.json
# NATIVE_PLAYER_INTEGRATION_ALERT_SUMMARY_PATH=scripts/native-player-integration.alert-summary.json
# Optional: alert history and weekly trend report output paths.
# NATIVE_PLAYER_INTEGRATION_ALERT_HISTORY_PATH=scripts/native-player-integration.alert-history.json
# NATIVE_PLAYER_INTEGRATION_ALERT_HISTORY_MAX_ENTRIES=500
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_JSON_PATH=scripts/native-player-integration.alert-report.json
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_MD_PATH=scripts/native-player-integration.alert-report.md
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WINDOW_DAYS=7
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_PUBLISH_STATUS_PATH=scripts/native-player-integration.alert-report-publish-status.json
# Optional: weekly report delivery webhook.
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_URL=https://hooks.example.com/native-gate-weekly-report
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_TOKEN=replace-with-weekly-token
# Optional: route weekly report by detected severity level (fallback to REPORT_WEBHOOK_URL).
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_URL_ERROR=https://hooks.example.com/native-gate-weekly-error
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_URL_WARNING=https://hooks.example.com/native-gate-weekly-warning
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_URL_INFO=https://hooks.example.com/native-gate-weekly-info
# Optional: level route tokens (fallback to REPORT_WEBHOOK_TOKEN).
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_TOKEN_ERROR=replace-with-weekly-error-token
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_TOKEN_WARNING=replace-with-weekly-warning-token
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_TOKEN_INFO=replace-with-weekly-info-token
# Optional: escalation weekly report channel (trigger when report contains escalated events).
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_ESCALATION_WEBHOOK_URL=https://hooks.example.com/native-gate-weekly-escalation
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_ESCALATION_WEBHOOK_TOKEN=replace-with-weekly-escalation-token
# Optional: extra broadcast channels for weekly report (comma-separated URLs).
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_WEBHOOK_URLS=https://hooks.example.com/weekly-ops,https://hooks.example.com/weekly-mgmt
# Optional: request signing for weekly report payload (HMAC timestamp + nonce + body).
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNING_SECRET=replace-with-weekly-signing-secret
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_HEADER=X-PyGBSentry-Signature
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_TIMESTAMP_HEADER=X-PyGBSentry-Signature-Timestamp
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_NONCE_HEADER=X-PyGBSentry-Signature-Nonce
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_ALGORITHM_HEADER=X-PyGBSentry-Signature-Algorithm
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_ENCODING_HEADER=X-PyGBSentry-Signature-Encoding
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_VERSION_HEADER=X-PyGBSentry-Signature-Version
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_ALGORITHM=sha256
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_ENCODING=hex
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_PREFIX=hmac
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_SIGNATURE_VERSION=v1
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_PUBLISH_RETRIES=1
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_PUBLISH_RETRY_DELAY_MS=1000
# Optional: CI-side signature verification/replay-protection dry-run.
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_VERIFY_REQUIRED=false
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_VERIFY_STATUS_PATH=scripts/native-player-integration.alert-report-verify-status.json
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_REPLAY_STATE_PATH=scripts/native-player-integration.alert-report-replay-state.json
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_VERIFY_SIGNING_SECRET=replace-with-weekly-signing-secret
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_VERIFY_MAX_TIMESTAMP_SKEW_SEC=300
# NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_VERIFY_NONCE_TTL_SEC=900
# Tip: set NATIVE_PLAYER_INTEGRATION_ALERT_REPORT_VERIFY_REQUIRED=true (repository variable) to enforce required gate on verify failure.

# Optional: override output path consumed by check-native-player-integration-report.mjs
# NATIVE_PLAYER_INTEGRATION_REPORT_PATH=scripts/native-player-integration.report.json

# Optional: fetch diagnostics status output path (for workflow summary/alerts).
# NATIVE_PLAYER_INTEGRATION_FETCH_STATUS_PATH=scripts/native-player-integration.fetch-status.json

# Optional: retry and timeout tuning for API fetch.
# NATIVE_PLAYER_INTEGRATION_FETCH_RETRIES=2
# NATIVE_PLAYER_INTEGRATION_FETCH_RETRY_DELAY_MS=1200
# NATIVE_PLAYER_INTEGRATION_FETCH_TIMEOUT_MS=10000

# Optional (debug only): read report from local file instead of API.
# NATIVE_PLAYER_INTEGRATION_REPORT_SOURCE_FILE=scripts/native-player-integration.report.sample.json

