{
  "name": "pygbsentry-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ --ext .vue,.js,.ts --fix",
    "format": "prettier --write src/",
    "test": "echo 'No tests yet' && exit 0",
    "check:preview-gate": "node ./scripts/check-preview-gate.mjs",
    "check:mobile-regression-gate": "node ./scripts/check-mobile-regression-gate.mjs",
    "check:mobile-regression-fetch-policy": "node ./scripts/check-mobile-regression-fetch-policy.mjs",
    "check:mobile-regression-report": "node ./scripts/check-mobile-regression-report.mjs",
    "check:native-player-capability": "node ./scripts/check-native-player-capability.mjs",
    "check:native-player-integration-report": "node ./scripts/check-native-player-integration-report.mjs",
    "fetch:mobile-regression-report": "node ./scripts/fetch-mobile-regression-report.mjs",
    "fetch:native-player-integration-report": "node ./scripts/fetch-native-player-integration-report.mjs",
    "report:native-player-integration-alert": "node ./scripts/build-native-integration-alert-report.mjs",
    "publish:native-player-integration-alert-report": "node ./scripts/publish-native-integration-alert-report.mjs",
    "notify:native-integration-failure": "node ./scripts/notify-native-integration-failure.mjs",
    "verify:native-player-integration-alert-report-signature": "node ./scripts/verify-native-integration-alert-report-signature.mjs",
    "ci:gate": "npm run typecheck && npm run check:preview-gate && npm run check:mobile-regression-gate && npm run check:mobile-regression-report && npm run check:native-player-capability && npm run check:native-player-integration-report"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060920250324001",
    "@dcloudio/uni-app-plus": "3.0.0-4060920250324001",
    "@dcloudio/uni-components": "3.0.0-4060920250324001",
    "@dcloudio/uni-h5": "3.0.0-4060920250324001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4060920250324001",
    "@dcloudio/uni-ui": "^1.5.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.9.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.16",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060920250324001",
    "typescript": "5.4.5",
    "vue-tsc": "^2.2.0"
  }
}
