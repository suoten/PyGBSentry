# PyGBSentry — Root Environment Configuration Example
# Copy this file to .env and modify values as needed.
# Or use: python tools/env_manager.py switch --env dev

# --- Docker Compose Secrets ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
# FIX: [2026-07-16] 字段加密独立密钥（生产必填！空值将拒绝启动）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
MEDIA_SERVER_SECRET=CHANGE_ME_ZLM_SECRET
BACKEND_PUBLIC_HOST=127.0.0.1
SIP_DEFAULT_PASSWORD=CHANGE_ME_SIP_PASSWORD
