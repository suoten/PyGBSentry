# PyGBSentry Environment Configuration
# 推荐使用:
# python tools/env_manager.py switch --env dev
# python tools/env_manager.py validate --env dev

# --- Project ---
PROJECT_NAME="PyGBSentry"
API_V1_STR="/api/v1"
LOG_DIR=logs
LOG_FORMAT=text
# P3-05: stderr 日志级别覆盖（空=自动：prod→WARNING, dev→INFO, debug→DEBUG）
# LOG_LEVEL_STDERR=

# --- Security ---
# Change this in production!
SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING"
# ⚠️ 生产环境(APP_ENV=prod)必填！空值将拒绝启动
ACCESS_TOKEN_EXPIRE_MINUTES=120
# P1-08: 生产环境强制 HTTPS（当 APP_ENV=prod 时，HTTP 请求自动 301 重定向到 HTTPS）
# FORCE_HTTPS_IN_PRODUCTION=true
# 是否允许未知设备自动注册并建库（True: 允许自动接管, False: 直接无视/拒绝未知设备）
ENABLE_AUTO_DISCOVERY=False
# 为 true 时，角色不足（require_roles 403）写入审计；默认 false 避免列表被刷满
# AUDIT_RBAC_ROLE_DENIALS=false
BACKEND_PUBLIC_HOST=localhost
# Docker 部署时必须修改为容器网络可达的 IP（如宿主机 IP 或 Docker 网关 IP），否则 ZLM Hook 不可达
BACKEND_PUBLIC_PORT=8000
# --- Docker 部署专属 ---
# Docker 容器内自动检测（设置为 true 启用 Docker 环境感知）
# RUNNING_IN_DOCKER=false
# RTP 端口映射范围（须与 docker-compose.yml 映射范围一致）
# RTP_PORT_RANGE_START=30000
# RTP_PORT_RANGE_END=30199
# Docker 下 RTP 端口范围上限（超过自动裁剪）
# DOCKER_RTP_PORT_RANGE_MAX=200
# SIP 状态存储后端：local（单进程内存）/ redis（多进程共享，需 Redis）
# SIP_STATE_BACKEND=local

# --- Database ---
# 数据库类型：postgresql（推荐生产）| mysql（可用）| sqlite（体验/单机）
DATABASE_TYPE=postgresql
# ── PostgreSQL（推荐生产，显式 DATABASE_* 写法） ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pygb28181
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 兼容旧写法（DATABASE_* 优先；未设 DATABASE_* 时回退 POSTGRES_*）
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=pygb28181
POSTGRES_PORT=5432
# ── MySQL（可用，需 DATABASE_TYPE=mysql） ──
# DATABASE_TYPE=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=pygb28181
# DATABASE_USER=root
# DATABASE_PASSWORD=你的密码
# ── SQLite（体验/单机，需 DATABASE_TYPE=sqlite） ──
# DATABASE_TYPE=sqlite
# DATABASE_SQLITE_PATH=./pygbsentry.db
# SQLITE_CONNECT_TIMEOUT_SECONDS=15
# 启动时是否跑「业务/行政区 parent 拆分」迁移（旧库升级）；默认 false，避免阻塞启动
# RUN_SPLIT_CATALOG_MIGRATIONS_ON_STARTUP=false
# 启动时使用 Alembic 迁移（推荐生产环境）；默认 true，设为 false 使用旧版 schema_upgrade
# USE_ALEMBIC=true
# 启动时是否从 data/region.sql 导入行政区划；默认 false（可用 scripts/seed_regions.py 离线导入）
# RUN_REGION_SEED_ON_STARTUP=false
# 启动时是否补全内置 ZLM 节点记录；默认 true
# ENSURE_EMBEDDED_MEDIA_NODE_ON_STARTUP=false
# P2-03: 慢查询监控阈值（秒），超过此值的查询将记录 WARNING 日志
# SLOW_QUERY_THRESHOLD_SECONDS=1.0

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 启动时是否连接 Redis（无 Redis 时建议 false，避免阻塞启动）
# INIT_REDIS_ON_STARTUP=false
# 若日志出现「init_redis timeout」：10s 内未连上则按设计继续启动（非致命）；需 Redis 时请检查地址/密码与防火墙。

# --- SIP Server ---
SIP_IP=0.0.0.0
SIP_PORT=5060
# SIP 启动是否强依赖：true=失败即退出，false=失败降级继续（仅管理端可用）
# SIP_STARTUP_REQUIRED=true
SIP_ID=34020000002000000001
SIP_DOMAIN=3402000000
SIP_WORKER_CONCURRENCY=200

# --- ZLMediaKit ---
# Change this secret in production!
# 须与 ZLM config.ini 中 [api] secret 一致，并与数据库「内置媒体节点」的 secret 一致，否则 ZLM 日志可能出现 Incorrect secret。
# Media ingest mode in current release: UDP RTP
# P1-49: 使用 CHANGE_ME 占位符提醒部署时必须修改
MEDIA_SERVER_SECRET="CHANGE_ME"
# ⚠️ 生产环境(APP_ENV=prod)必填！默认值/空值将拒绝启动；开发环境空值时自动生成
MEDIA_SERVER_HOST=127.0.0.1
MEDIA_SERVER_HTTP_PORT=8880
MEDIA_SERVER_RTSP_PORT=554
MEDIA_SERVER_RTMP_PORT=1935
MEDIA_SERVER_RTC_PORT=8000
MEDIA_SERVER_RTC_TCP_PORT=0
MEDIA_SERVER_RTP_PROXY_PORT=30000
MEDIA_SERVER_RTP_PROXY_PORT_RANGE=30000-30999
MEDIA_SERVER_RTP_STREAM_MODE=UDP
# P0-RTP: ZLM RTP Server 超时秒数（NAT场景建议>=30）
RTP_SERVER_TIMEOUT_SECONDS=30
# P0-RTP: RTP超时宽限期秒数（INVITE后多少秒内忽略ZLM超时回调）
RTP_TIMEOUT_GRACE_PERIOD_SECONDS=20
STREAM_SELF_HEAL_PROBE_ENABLED=true
STREAM_SELF_HEAL_PROBE_MIN_SUCCESS_TOTAL=20
STREAM_SELF_HEAL_PROBE_MAX_FAILURE_RATE=10
STREAM_SELF_HEAL_PROBE_MAX_IDLE_MINUTES=60
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_MIN_HIGH_RISK=3
HEALTH_ALERT_HOLD_MINUTES=5
HEALTH_ALERT_COOLDOWN_MINUTES=10
ALARM_ESCALATION_ENABLED=true
ALARM_ESCALATION_FIRST_MINUTES=5
ALARM_ESCALATION_MAX_LEVEL=3
ALARM_ESCALATION_PRIORITY_MINUTES=1:2,2:5,3:10,4:15
SLA_BREACH_NOTIFY_ENABLED=true
SLA_BREACH_CONSECUTIVE_CYCLES=3
SLA_BREACH_WECHAT_WEBHOOK_URL=
SLA_BREACH_FEISHU_WEBHOOK_URL=
REPORT_DAILY_SEND_ENABLED=false
REPORT_DAILY_SEND_TIME_UTC=01:00
REPORT_DAILY_WEBHOOK_URL=
REPORT_DAILY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=
LICENSE_SIGNING_SECRET=""
LICENSE_ED25519_PUBLIC_KEY=
LICENSE_ED25519_PRIVATE_KEY=
LICENSE_OFFLINE_PUBLIC_KEY=
ENTERPRISE_OFFLINE_LICENSE_REQUIRED=false
APP_EDITION=oss
# 演示模式：设为 true 时设备列表展示内置演示设备（仅体验用，无真实视频流）
DEMO_MODE=false
COMMERCIAL_MODEL=oss_open
COMMUNITY_PLAN_CODE=community
TRIAL_REMINDER_DAYS=7
SUBSCRIPTION_REMINDER_DAYS=7
SUBSCRIPTION_REMINDER_WEBHOOK_URL=
# P2-34: 使用占位符替代硬编码外部域名
PLUGIN_MARKETPLACE_BASE_URL=https://YOUR_MARKETPLACE_HOST.example.com
# 付费插件访问 runtime/plugin-assets 时是否每次向服务器版 install-check（默认 false，见 PLUGIN_ECOSYSTEM_STATUS.md §3.1）
PLUGIN_PAID_RUNTIME_INSTALL_CHECK=false
# plugin.json manifest 签名（Ed25519）公钥（可选；若为空则回退 LICENSE_ED25519_PUBLIC_KEY）
PLUGIN_MANIFEST_ED25519_PUBLIC_KEY=
# 强制所有插件必须带有效 manifest_signature（默认 false）
PLUGIN_MANIFEST_SIGNATURE_REQUIRED=false
# 插件包（ZIP 整包）签名验签公钥（可选；未设置时回退 LICENSE_ED25519_PUBLIC_KEY）
PLUGIN_PACKAGE_ED25519_PUBLIC_KEY=
# 强制 marketplace/install 必须提供 package_signature（默认 true）
PLUGIN_PACKAGE_SIGNATURE_REQUIRED=true
# 插件 Hook 超时隔离：秒；0 表示不启用
PLUGIN_HOOK_EXEC_TIMEOUT_SECONDS=30

# 插件 Hook 超时隔离模式：thread（默认）| process（进程级 terminate；更适合“同步模块级函数”）
PLUGIN_HOOK_EXEC_TIMEOUT_MODE=thread
PAYMENT_CALLBACK_SECRET=""
PAYMENT_SUCCESS_RETURN_URL=https://YOUR_FRONTEND_HOST.example.com/billing
STREAM_PUBLIC_HOST=localhost
STREAM_PUBLIC_HTTP_PORT=8880
MEDIA_SERVER_HOOK_BASE_URL=
# 多流媒体节点集群（开源默认）：不配置则单节点。JSON 数组示例：
# MEDIA_NODES=[{"id":"zlm1","host":"192.168.1.10","http_port":8880,"rtp_port":30000,"public_host":"zlm1.example.com","public_http_port":8880},{"id":"zlm2","host":"192.168.1.11","http_port":8880,"rtp_port":30000,"public_host":"zlm2.example.com","public_http_port":8880}]

# --- CORS ---
# Allow your frontend domain
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost"]

# --- Additional Config ---
# SIP 默认密码（P1-49: 使用 CHANGE_ME 占位符，部署时必须修改）
SIP_DEFAULT_PASSWORD=CHANGE_ME
# SIP Nonce 签名密钥（空值使用系统默认）
SIP_NONCE_SECRET=
# 字段加密独立密钥（必填！空值将拒绝加解密设备/平台密码）。生成命令：
#   python -c "import secrets; print(secrets.token_hex(32))"
FIELD_ENCRYPTION_KEY=
# 是否启用 OpenAPI 文档（默认 false）
ENABLE_OPENAPI_DOCS=false
# 是否启用安全响应头（默认 true）
ENABLE_SECURITY_HEADERS=true
# 是否启用 CSP（默认 true）
ENABLE_CSP=true
# 是否允许无 Token 播放（默认 false）
PLAY_ALLOW_NO_TOKEN=false
# 是否启用自动播放（默认 true）
AUTO_PLAY_ENABLED=true
# GB28181 协议版本（默认 2016）
GB28181_VERSION=2016
# 通道树是否推断区域放置（默认 true）
CHANNEL_TREE_INFER_REGION_PLACEMENT=true
# 应用语言（默认 zh）
APP_LANGUAGE=zh

# =============================================================================
# 启动与访问日志：常见「非致命」说明（排障）
# =============================================================================
# - Redis 10s 超时：未连上 Redis 时按设计可继续运行；需要缓存/队列时再配 REDIS_* 或关闭 INIT_REDIS_ON_STARTUP。
# - which: no ffmpeg：运行后端的进程环境里没有 ffmpeg；PATH 含 /usr/local/ffmpeg/bin 但目录为空时也会报错，转码等能力受影响。
#   可安装系统包或执行 scripts/install_ffmpeg_from_source.sh。
# - ZLM SSL 证书文件缺失：仅在使用 ZLM HTTPS 时需配置证书；只用 HTTP 时可忽略。
# - 401 Unauthorized：未带有效 Token 访问需登录接口，属正常。
# - POST /login/access-token 先 400 后 200：多为首次请求参数或 Content-Type 不正确，修正后第二次成功。
