# --- Project ---
PROJECT_NAME="PyGBSentry"
API_V1_STR="/api/v1"
# 生产环境必须设为 prod（触发安全校验、HTTPS 重定向等）
APP_ENV=prod
# 错误消息语言 (zh/en)
APP_LANGUAGE=zh
APP_TIMEZONE=Asia/Shanghai

# --- Security ---
# JWT 签名密钥（生产必填！空值将拒绝启动）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING"
# FIX: [2026-07-16] 字段加密独立密钥（生产必填！空值将拒绝启动）
# 用于加密 MediaNode.secret、Asset.password、ParentPlatform.password 等敏感字段
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
FIELD_ENCRYPTION_KEY="CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING"
# SIP nonce HMAC 独立密钥（生产建议独立设置，为空时从 SECRET_KEY 派生）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SIP_NONCE_SECRET=""
# TOTP 密钥加密独立密钥（为空时从 SECRET_KEY 派生，建议独立设置）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
TOTP_ENCRYPTION_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# 后端公网访问地址（域名或IP）— 用于 SIP Contact 头和 CORS
# 重要：如果是域名，系统会自动 DNS 解析为 IP 用于 SIP Via/Call-ID 头（兼容 EasyGBS）
BACKEND_PUBLIC_HOST=backend
BACKEND_PUBLIC_PORT=8000
# 是否允许未知设备自动注册并建库（True: 允许自动接管, False: 直接无视/拒绝未知设备）
ENABLE_AUTO_DISCOVERY=True

# --- Readiness / Health Check ---
# FIX [2026-07-29 P0]: ZLM 故障是否导致 readiness 探针失败（503）
# false（推荐）: ZLM 故障只影响视频播放，SIP 信令/通道同步正常，readiness 返回 200
# true: ZLM 故障时 readiness 返回 503，外部进程管理器会重启服务（可能导致崩溃重启死循环）
# 重要：如果使用宝塔/systemd/Docker 健康检查，务必设为 false，否则 ZLM 缺失会导致服务反复重启
READINESS_FAIL_ON_ZLM_DOWN=false

# --- Database ---
# 数据库类型：postgresql（推荐生产）| mysql（可用）| sqlite（不推荐生产）
DATABASE_TYPE=postgresql
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=pygb28181
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 兼容旧写法（DATABASE_* 优先；未设 DATABASE_* 时回退 POSTGRES_*）
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=pygb28181
POSTGRES_PORT=5432
# ── MySQL（可用，需 DATABASE_TYPE=mysql） ──
# DATABASE_TYPE=mysql
# DATABASE_HOST=db
# DATABASE_PORT=3306
# DATABASE_NAME=pygb28181
# DATABASE_USER=root
# DATABASE_PASSWORD=你的密码
# ── SQLite（不推荐生产） ──
# DATABASE_TYPE=sqlite
# DATABASE_SQLITE_PATH=./pygbsentry.db
# 生产推荐使用 Alembic 管理数据库迁移
# USE_ALEMBIC=true
# P2-7: asyncpg 预处理语句缓存（PostgreSQL 专用）。根因已由 before_cursor_execute 事件修复，
# 设为 100 可恢复 5-15% 性能；如遇兼容性问题可改回 0。SQLite 忽略此项。
# DB_STATEMENT_CACHE_SIZE=0
# 数据库连接池配置（多实例部署时注意：pool_size + max_overflow <= PostgreSQL max_connections / 实例数）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DB=0
# 若日志出现 init_redis timeout：10s 内未连上则继续启动（非致命）；生产需要 Redis 时请检查服务与密码。

# --- SIP Server ---
SIP_IP=0.0.0.0
SIP_PORT=5060
SIP_ID=34020000002000000001
SIP_DOMAIN=3402000000
# FIX [2026-07-29 P0]: From/To URI host 使用 IP 而非 SIP_DOMAIN（行政区划码）
# EasyGBS 等非标准平台对 SIP_DOMAIN host 的 MESSAGE 返回 400 Bad Request
# true: 使用 IP 地址（推荐，兼容 EasyGBS 等非标准平台）
# false: 使用 SIP_DOMAIN（GB28181 标准，但 EasyGBS 不兼容）
SIP_FROM_TO_USE_IP=true
SIP_WORKER_CONCURRENCY=1000
# FIX: [2026-07-16 P1] SIP 默认密码生产必填，空值将拒绝启动
# 用于新注册设备的初始 SIP 认证密码，建议生成强随机密码
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(16))"
SIP_DEFAULT_PASSWORD="CHANGE_ME_GENERATE_A_STRONG_SIP_PASSWORD"
# FIX [2026-07-29 P0]: SIP 认证宽松模式 — 兼容 EasyGBS 等非标准客户端
# true: 接受 SHA-256/MD5 算法不匹配、stale nonce 等非标准行为（推荐生产环境开启）
# false: 严格遵循 RFC 2617（可能导致 EasyGBS 等设备注册失败）
SIP_AUTH_RELAXED=true

# --- ZLMediaKit ---
# 须与 ZLM config.ini [api] secret、数据库内置媒体节点 secret 一致，避免 ZLM Incorrect secret。
MEDIA_SERVER_SECRET="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
MEDIA_SERVER_HOST=127.0.0.1
MEDIA_SERVER_HTTP_PORT=8880
MEDIA_SERVER_RTSP_PORT=554
MEDIA_SERVER_RTMP_PORT=1935
MEDIA_SERVER_RTP_PROXY_PORT=30000
MEDIA_SERVER_RTP_PROXY_PORT_RANGE=30000-30999
MEDIA_SERVER_RTP_STREAM_MODE=UDP
STREAM_PUBLIC_HOST=localhost
STREAM_PUBLIC_HTTP_PORT=8880
MEDIA_SERVER_HOOK_BASE_URL=

# --- Embedded ZLMediaKit (内置 ZLM 自动部署) ---
# 是否启用内置 ZLM（自动下载/编译/启动 MediaServer 进程）
EMBEDDED_ZLM_ENABLED=true
# 内置 ZLM 启动超时（秒）— 编译可能耗时 5-30 分钟，设为 0 表示不阻塞启动
EMBEDDED_ZLM_START_TIMEOUT_SECONDS=0
# ZLM 预编译二进制下载 URL（推荐！避免源码编译耗时过长）
# 格式：tar.gz 或 zip 包，包含 MediaServer 二进制文件
# 官方 release: https://github.com/ZLMediaKit/ZLMediaKit/releases
# 镜像下载: https://gitee.com/xia-chu/ZLMediaKit/attach_files
# 示例：ZLM_FALLBACK_BINARY_URL=https://github.com/ZLMediaKit/ZLMediaKit/releases/download/v12.0.0/ZLMediaKit_linux_x86_64_v12.0.0.tar.gz
ZLM_FALLBACK_BINARY_URL=
# ZLM 下载最大耗时（秒），超时则放弃下载
ZLM_DOWNLOAD_MAX_SECONDS=300
# 是否允许源码编译 ZLM（生产环境默认关闭，因为编译耗时 5-30 分钟）
# true: 缺乏预编译二进制时从源码编译（需要 cmake/gcc/git）
# false: 不编译，仅依赖预编译二进制
ZLM_BUILD_FROM_SOURCE=false
# 源码编译 CPU 核心数（0=自动检测）
ZLM_BUILD_JOBS=0
# 源码编译最低 CPU 核心数（不满足则跳过编译）
ZLM_BUILD_MIN_CPU=2
# 源码编译最低内存（GB）
ZLM_BUILD_MIN_MEM_GB=3
# 是否强制源码编译（忽略资源门槛检查）
ZLM_BUILD_FORCE=false

# --- Feature Flags / Ops ---
# 演示模式：生产一般建议关闭
DEMO_MODE=false

# --- Performance / Self Heal ---
STREAM_SELF_HEAL_PROBE_ENABLED=true
STREAM_SELF_HEAL_PROBE_MIN_SUCCESS_TOTAL=20
STREAM_SELF_HEAL_PROBE_MAX_FAILURE_RATE=10
STREAM_SELF_HEAL_PROBE_MAX_IDLE_MINUTES=60

# --- Health / Alerts ---
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_MIN_HIGH_RISK=3
HEALTH_ALERT_HOLD_MINUTES=5
HEALTH_ALERT_COOLDOWN_MINUTES=10

# --- Alarm Escalation / SLA ---
ALARM_ESCALATION_ENABLED=true
ALARM_ESCALATION_FIRST_MINUTES=5
ALARM_ESCALATION_MAX_LEVEL=3
ALARM_ESCALATION_PRIORITY_MINUTES=1:2,2:5,3:10,4:15
SLA_BREACH_NOTIFY_ENABLED=true
SLA_BREACH_CONSECUTIVE_CYCLES=3
SLA_BREACH_WECHAT_WEBHOOK_URL=
SLA_BREACH_FEISHU_WEBHOOK_URL=

# --- Reports (Daily) ---
REPORT_DAILY_SEND_ENABLED=false
REPORT_DAILY_SEND_TIME_UTC=01:00
REPORT_DAILY_WEBHOOK_URL=
REPORT_DAILY_EMAIL_TO=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=

# --- License / Billing (OSS defaults) ---
LICENSE_SIGNING_SECRET=""
LICENSE_ED25519_PUBLIC_KEY=
LICENSE_ED25519_PRIVATE_KEY=
LICENSE_OFFLINE_PUBLIC_KEY=
ENTERPRISE_OFFLINE_LICENSE_REQUIRED=false
APP_EDITION=oss
COMMERCIAL_MODEL=oss_open
COMMUNITY_PLAN_CODE=community
TRIAL_REMINDER_DAYS=7
SUBSCRIPTION_REMINDER_DAYS=7
SUBSCRIPTION_REMINDER_WEBHOOK_URL=
# P2-34: 使用占位符替代硬编码外部域名
PLUGIN_MARKETPLACE_BASE_URL=https://YOUR_MARKETPLACE_HOST.example.com
PAYMENT_CALLBACK_SECRET=""
PAYMENT_SUCCESS_RETURN_URL=https://YOUR_FRONTEND_HOST.example.com/billing

# --- Media Nodes (optional) ---
# 多流媒体节点集群：不配置则单节点。JSON 数组示例：
# MEDIA_NODES=[{"id":"zlm1","host":"192.168.1.10","http_port":8880,"rtp_port":30000,"public_host":"zlm1.example.com","public_http_port":8880},{"id":"zlm2","host":"192.168.1.11","http_port":8880,"rtp_port":30000,"public_host":"zlm2.example.com","public_http_port":8880}]

# --- CORS ---
BACKEND_CORS_ORIGINS=["https://your-frontend-domain.com"]

# --- OpenTelemetry / 分布式追踪 (P2-20 评估) ---
# OTEL 默认关闭。生产环境建议启用以获得分布式追踪能力，但需先部署 collector（如 Jaeger/Tempo）。
# 未配置 collector 时盲目开启会导致连接重试（日志噪声 + 轻微性能开销）。
# 启用步骤：
#   1. 部署 OTLP collector（如 jaegertracing/all-in-one）
#   2. 设置 OTEL_ENABLED=true
#   3. 设置 OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector>:4317
#   4. （可选）OTEL_SERVICE_NAME=pygbsentry-prod
# OTEL_ENABLED=false
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=pygbsentry

# =============================================================================
# 启动与访问日志：常见「非致命」说明（排障）
# =============================================================================
# - Redis 10s 超时：未连上时可继续运行；需要 Redis 时再查 REDIS_* 与网络。
# - which: no ffmpeg：进程 PATH 无 ffmpeg 或安装目录为空；可用系统包或 scripts/install_ffmpeg_from_source.sh。
# - ZLM SSL 证书缺失：未启用 ZLM HTTPS 可忽略。
# - 401：未带 JWT 访问受保护接口为正常行为。
# - /login/access-token 先 400 后 200：多为首次请求体/参数错误，第二次成功。
