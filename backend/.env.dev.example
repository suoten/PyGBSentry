# --- Project ---
PROJECT_NAME="PyGBSentry"
API_V1_STR="/api/v1"

# --- Security ---
# FIXED: 真实密钥替换为占位符，示例文件不应包含真实密钥
SECRET_KEY="replace-with-a-random-64-char-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_PUBLIC_HOST=localhost
BACKEND_PUBLIC_PORT=8000
# 是否允许未知设备自动注册并建库（True: 允许自动接管, False: 直接无视/拒绝未知设备）
ENABLE_AUTO_DISCOVERY=True

# --- Database ---
# 数据库类型：postgresql（推荐）| mysql（可用）| sqlite（体验/单机）
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pygb28181
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD  # FIXED: 弱密码替换为占位符
# 兼容旧写法（DATABASE_* 优先；未设 DATABASE_* 时回退 POSTGRES_*）
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD  # FIXED: 弱密码替换为占位符
POSTGRES_DB=pygb28181
POSTGRES_PORT=5432
# ── MySQL（可用，需 DATABASE_TYPE=mysql） ──
# DATABASE_TYPE=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=pygb28181
# DATABASE_USER=root
# DATABASE_PASSWORD=你的密码
# ── SQLite（体验/单机，需 DATABASE_TYPE=sqlite） ──
# DATABASE_TYPE=sqlite
# DATABASE_SQLITE_PATH=./pygbsentry.db
# SQLITE_CONNECT_TIMEOUT_SECONDS=15

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# init_redis timeout：未连上则继续启动（非致命）；见文末「排障」。

# --- SIP Server ---
SIP_IP=0.0.0.0
SIP_PORT=5060
SIP_ID=34020000002000000001
SIP_DOMAIN=3402000000
SIP_WORKER_CONCURRENCY=1000

# --- ZLMediaKit ---
# 须与 ZLM config.ini [api] secret、内置媒体节点 secret 一致；见文末「排障」。
MEDIA_SERVER_SECRET="replace-with-zlm-secret"  # FIXED: 真实密钥替换为占位符
MEDIA_SERVER_HOST=127.0.0.1
MEDIA_SERVER_HTTP_PORT=8880
MEDIA_SERVER_RTSP_PORT=554
MEDIA_SERVER_RTMP_PORT=1935
MEDIA_SERVER_RTP_PROXY_PORT=30000
MEDIA_SERVER_RTP_PROXY_PORT_RANGE=30000-30999
MEDIA_SERVER_RTP_STREAM_MODE=UDP
STREAM_PUBLIC_HOST=localhost
STREAM_PUBLIC_HTTP_PORT=8880
MEDIA_SERVER_HOOK_BASE_URL=

# --- Feature Flags / Ops ---
# 演示模式：设为 true 时设备列表展示内置演示设备（仅体验用，无真实视频流）
DEMO_MODE=false

# --- Performance / Self Heal ---
STREAM_SELF_HEAL_PROBE_ENABLED=true
STREAM_SELF_HEAL_PROBE_MIN_SUCCESS_TOTAL=20
STREAM_SELF_HEAL_PROBE_MAX_FAILURE_RATE=10
STREAM_SELF_HEAL_PROBE_MAX_IDLE_MINUTES=60

# --- Health / Alerts ---
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_MIN_HIGH_RISK=3
HEALTH_ALERT_HOLD_MINUTES=5
HEALTH_ALERT_COOLDOWN_MINUTES=10

# --- Alarm Escalation / SLA ---
ALARM_ESCALATION_ENABLED=true
ALARM_ESCALATION_FIRST_MINUTES=5
ALARM_ESCALATION_MAX_LEVEL=3
ALARM_ESCALATION_PRIORITY_MINUTES=1:2,2:5,3:10,4:15
SLA_BREACH_NOTIFY_ENABLED=true
SLA_BREACH_CONSECUTIVE_CYCLES=3
SLA_BREACH_WECHAT_WEBHOOK_URL=
SLA_BREACH_FEISHU_WEBHOOK_URL=

# --- Reports (Daily) ---
REPORT_DAILY_SEND_ENABLED=false
REPORT_DAILY_SEND_TIME_UTC=01:00
REPORT_DAILY_WEBHOOK_URL=
REPORT_DAILY_EMAIL_TO=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=

# --- License / Billing (OSS defaults) ---
LICENSE_SIGNING_SECRET="replace-with-a-random-64-char-hex-string"  # FIXED: 真实密钥替换为占位符
LICENSE_ED25519_PUBLIC_KEY=
LICENSE_ED25519_PRIVATE_KEY=
LICENSE_OFFLINE_PUBLIC_KEY=
ENTERPRISE_OFFLINE_LICENSE_REQUIRED=false
APP_EDITION=oss
COMMERCIAL_MODEL=oss_open
COMMUNITY_PLAN_CODE=community
TRIAL_REMINDER_DAYS=7
SUBSCRIPTION_REMINDER_DAYS=7
SUBSCRIPTION_REMINDER_WEBHOOK_URL=
# P2-34: 使用占位符替代硬编码外部域名
PLUGIN_MARKETPLACE_BASE_URL=https://YOUR_MARKETPLACE_HOST.example.com
PAYMENT_CALLBACK_SECRET="replace-with-a-random-64-char-hex-string"  # FIXED: 真实密钥替换为占位符
PAYMENT_SUCCESS_RETURN_URL=https://YOUR_FRONTEND_HOST.example.com/billing

# --- Media Nodes (optional) ---
# 多流媒体节点集群：不配置则单节点。JSON 数组示例：
# MEDIA_NODES=[{"id":"zlm1","host":"192.168.1.10","http_port":8880,"rtp_port":30000,"public_host":"zlm1.example.com","public_http_port":8880},{"id":"zlm2","host":"192.168.1.11","http_port":8880,"rtp_port":30000,"public_host":"zlm2.example.com","public_http_port":8880}]

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost"]

# =============================================================================
# 启动与访问日志：常见「非致命」说明（排障）
# =============================================================================
# - Redis 10s 超时：未连上时可继续运行；需要 Redis 时再查 REDIS_*。
# - which: no ffmpeg：PATH 无 ffmpeg 或目录为空；可用系统包或 scripts/install_ffmpeg_from_source.sh。
# - ZLM SSL 证书缺失：未启用 ZLM HTTPS 可忽略。
# - 401：未带 JWT 访问受保护接口为正常。
# - /login/access-token 先 400 后 200：多为首次请求体/参数错误。
# - MEDIA_SERVER_SECRET 须与 ZLM config.ini [api] secret、数据库内置媒体节点一致，避免 Incorrect secret。
